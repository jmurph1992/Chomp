# Neon Postgres — used by Prisma CLI commands run from packages/db
# (prisma migrate, prisma studio, prisma db push, etc.)
#
# Copy this file to .env and fill in real values:
#   cp packages/db/.env.example packages/db/.env
#
# Both DATABASE_URL and DIRECT_URL should point at the same Neon connection
# string, using the direct (non-pooled) host — no "-pooler" in the hostname.
# Neon requires the direct connection for migrations; DIRECT_URL exists
# separately from DATABASE_URL only because some deployments point
# DATABASE_URL at a pooled connection for the app itself.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://user:password@host/neondb?sslmode=require&channel_binding=require
