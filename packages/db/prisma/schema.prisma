// Chomp database schema
// ORM: Prisma 6 + PostgreSQL + PostGIS on Neon
// Note: PostGIS geography types use Unsupported() — geospatial queries
//       (ST_DWithin, ST_Distance) must use prisma.$queryRaw

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; Vercel's serverless Function runtime needs
  // its own engine binary explicitly listed or Prisma Client can't find a
  // query engine at request time (https://pris.ly/d/engine-not-found-nextjs).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Neon requires a direct URL for migrations
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  customer
  operator
  admin
}

enum OperatorRole {
  owner
  manager
}

/// pending: newly created, not yet reviewed. verified: admin-approved, publicly visible.
/// rejected: admin-declined (verificationNote holds why). onHold: was verified, an admin
/// pulled it back off the map (verificationNote holds why) without treating it as a fresh
/// rejection.
enum VerificationStatus {
  pending
  verified
  rejected
  onHold
}

/// pending: created, link not yet used. accepted: claimed, TruckOperator row created.
/// cancelled: owner revoked before it was claimed. expired: past expiresAt, written lazily
/// on the next claim attempt against a stale row rather than via a scheduled sweep.
enum InviteStatus {
  pending
  accepted
  cancelled
  expired
}

/// Which condition put an entry in the moderation queue. Only one reason exists so
/// far (a user's account erasure is blocked because they're the sole owner of at
/// least one truck) but the table is deliberately generic — see ModerationQueueEntry.
enum ModerationQueueReason {
  userErasureBlockedBySoleOwnership
}

/// open: needs an admin to act. resolved: the blocker cleared and the held action
/// (e.g. erasure) completed. dismissed: an admin decided NOT to complete the held
/// action — the subject's blocking trucks are reactivated and (for erasure) their
/// Clerk account is unbanned, restoring them rather than erasing them.
enum ModerationQueueStatus {
  open
  resolved
  dismissed
}

/// direct: the webhook fired and nothing was held — self-service deletion, an
/// admin's non-blocked deletion, or a deletion made directly in Clerk's dashboard
/// are all indistinguishable from our side, and don't need to be distinguished for
/// this record's purpose. resolvedFromModerationQueue: the erasure had been held
/// pending a ModerationQueueEntry resolution.
enum ErasureTrigger {
  direct
  resolvedFromModerationQueue
}

// ─── Users ───────────────────────────────────────────────────────────────────

/// Mirrors Clerk users into the DB for relational data.
/// Created/updated via Clerk webhook on user.created / user.updated events.
model User {
  id          String   @id @default(uuid())
  clerkId     String   @unique @map("clerk_id")
  email       String   @unique
  role        UserRole @default(customer)
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")
  /// Opt-in only, off by default — favoriting a truck does not itself enable
  /// these emails. Managed from /account.
  notifyFavoriteActive Boolean @default(false) @map("notify_favorite_active")

  ownedTrucks                      Truck[]                @relation("TruckOwner")
  pendingOwnedTrucks               Truck[]                @relation("TruckPendingOwner")
  truckOperators                   TruckOperator[]
  reviews                          Review[]
  reviewPhotos                     ReviewPhoto[]
  photoLikes                       PhotoLike[]
  moderatedReviews                 Review[]               @relation("ReviewModerator")
  moderatedReviewPhotos            ReviewPhoto[]          @relation("ReviewPhotoModerator")
  sentInvites                      TruckInvite[]          @relation("InviteCreatedBy")
  acceptedInvites                  TruckInvite[]          @relation("InviteAcceptedBy")
  truckFavorites                   TruckFavorite[]
  menuItemFavorites                MenuItemFavorite[]
  moderationQueueEntriesAsSubject  ModerationQueueEntry[] @relation("ModerationQueueSubject")
  moderationQueueEntriesAsResolver ModerationQueueEntry[] @relation("ModerationQueueResolvedBy")
  contentReportsFiled              ContentReport[]        @relation("ContentReportReporter")
  contentReportsResolved           ContentReport[]        @relation("ContentReportResolvedBy")

  @@map("users")
}

// ─── Trucks ──────────────────────────────────────────────────────────────────

/// Core truck profile. One truck can have multiple operators (owner + managers).
model Truck {
  id                 String             @id @default(uuid())
  ownerId            String             @map("owner_id") // required, RESTRICT on delete — see owner relation below
  pendingOwnerId     String?            @map("pending_owner_id") // set while an owner-initiated transfer awaits the target manager's accept/decline
  name               String
  slug               String             @unique // SEO-friendly URL: /trucks/taco-kings
  description        String?
  cuisineType        String[]           @map("cuisine_type") // e.g. ['mexican', 'fusion']
  phone              String?
  website            String?
  instagram          String?
  logoUrl            String?            @map("logo_url")
  coverUrl           String?            @map("cover_url")
  /// IANA identifier (e.g. "America/Chicago"), set manually by the operator on
  /// the profile form — not auto-derived from a posted location. Null until set;
  /// the "Open now" indicator (lib/schedule.ts, @chomp/utils/open-now.ts) simply
  /// doesn't render for a truck without one, same as before this field existed.
  timezone           String?
  verificationStatus VerificationStatus @default(pending) @map("verification_status") // set by admin
  verificationNote   String?            @map("verification_note") // rejection/hold reason, cleared on verify
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at")

  // Deliberately left required + RESTRICT (unlike every other FK to User touched by
  // account erasure) — this is the DB-level backstop that guarantees a truck can
  // never end up ownerless: Postgres itself refuses `DELETE FROM users` for a sole
  // owner regardless of what application code does or forgets to do. The app-level
  // sole-ownership check in lib/user-erasure.ts exists to give a good UX and a
  // moderation queue *before* ever hitting this wall, not to replace it.
  owner          User            @relation("TruckOwner", fields: [ownerId], references: [id])
  pendingOwner   User?           @relation("TruckPendingOwner", fields: [pendingOwnerId], references: [id])
  operators      TruckOperator[]
  invites        TruckInvite[]
  locations      TruckLocation[]
  schedules      TruckSchedule[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  events         TruckEvent[]
  reviews        Review[]
  reviewPhotos   ReviewPhoto[]
  favorites      TruckFavorite[]

  @@map("trucks")
}

/// Allows one user to manage multiple trucks, or multiple users to co-manage one truck.
model TruckOperator {
  truckId String       @map("truck_id")
  userId  String       @map("user_id")
  role    OperatorRole @default(owner)

  truck Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)
  // Cascade: a manager/owner role is purely personal to the user holding it — no
  // third-party interest in keeping it once they're erased, same bucket as
  // TruckFavorite/MenuItemFavorite below. (Truck.ownerId itself is a separate,
  // required, non-cascading FK — see its own comment for why.)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([truckId, userId])
  @@map("truck_operators")
}

/// A pending offer to become a manager on a truck, delivered as a shareable link
/// (no email sending) — invitedEmail is checked against the Clerk-authenticated
/// claimant's email at claim time, never used to send mail. invitedEmail is stored
/// lowercased so the claim-time comparison is a plain equality check.
model TruckInvite {
  id               String       @id @default(uuid())
  truckId          String       @map("truck_id")
  invitedEmail     String       @map("invited_email")
  token            String       @unique
  status           InviteStatus @default(pending)
  createdByUserId  String?      @map("created_by_user_id") // nullable: SetNull when the creator is erased — the invite record itself outlives them
  createdAt        DateTime     @default(now()) @map("created_at")
  expiresAt        DateTime     @map("expires_at")
  acceptedAt       DateTime?    @map("accepted_at")
  acceptedByUserId String?      @map("accepted_by_user_id")

  truck          Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)
  createdBy      User? @relation("InviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  // Was already nullable with no onDelete written — Prisma's implicit default for an
  // optional relation is already SetNull (confirmed: generating a migration off this
  // explicit annotation produced no DDL change), so this makes existing behavior
  // explicit rather than changing it.
  acceptedByUser User? @relation("InviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([truckId, status])
  @@map("truck_invites")
}

// ─── Location ─────────────────────────────────────────────────────────────────

/// Each row is a location report. Only one row per truck should have isCurrent = true.
/// Previous rows are kept as history. A partial GiST index is maintained in a
/// migration on the geom column WHERE is_current = true for fast spatial queries.
model TruckLocation {
  id         String                                 @id @default(uuid())
  truckId    String                                 @map("truck_id")
  geom       Unsupported("geography(Point, 4326)")? // PostGIS point (lng, lat)
  address    String?
  city       String?
  state      String?
  zip        String?
  isCurrent  Boolean                                @default(true) @map("is_current")
  reportedAt DateTime                               @default(now()) @map("reported_at")
  expiresAt  DateTime?                              @map("expires_at")

  truck Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)

  @@map("truck_locations")
}

// ─── Schedules ────────────────────────────────────────────────────────────────

/// Supports both recurring weekly schedules (dayOfWeek set) and one-off dates (specificDate set).
/// A row with dayOfWeek = 2 and no specificDate means "every Tuesday".
model TruckSchedule {
  id           String                                 @id @default(uuid())
  truckId      String                                 @map("truck_id")
  dayOfWeek    Int?                                   @map("day_of_week") // 0=Sun, 6=Sat
  specificDate DateTime?                              @map("specific_date") @db.Date
  startTime    DateTime?                              @map("start_time") @db.Time(6)
  endTime      DateTime?                              @map("end_time") @db.Time(6)
  locationNote String?                                @map("location_note")
  address      String?
  geom         Unsupported("geography(Point, 4326)")?
  isCancelled  Boolean                                @default(false) @map("is_cancelled")
  createdAt    DateTime                               @default(now()) @map("created_at")

  truck Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)

  @@map("truck_schedules")
}

// ─── Menus ────────────────────────────────────────────────────────────────────

/// Top-level grouping for menu items (e.g. Tacos, Drinks, Sides).
model MenuCategory {
  id           String @id @default(uuid())
  truckId      String @map("truck_id")
  name         String
  displayOrder Int    @default(0) @map("display_order")

  truck Truck      @relation(fields: [truckId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@map("menu_categories")
}

/// Individual items within a menu category.
/// dietaryFlags supports client-side filtering (vegan, gluten-free, spicy, etc.)
model MenuItem {
  id           String   @id @default(uuid())
  categoryId   String   @map("category_id")
  truckId      String   @map("truck_id")
  name         String
  description  String?
  price        Decimal? @db.Decimal(8, 2)
  imageUrl     String?  @map("image_url")
  isAvailable  Boolean  @default(true) @map("is_available")
  isFeatured   Boolean  @default(false) @map("is_featured")
  dietaryFlags String[] @map("dietary_flags")
  createdAt    DateTime @default(now()) @map("created_at")

  category  MenuCategory       @relation(fields: [categoryId], references: [id])
  truck     Truck              @relation(fields: [truckId], references: [id], onDelete: Cascade)
  favorites MenuItemFavorite[]

  @@map("menu_items")
}

// ─── Reviews & Photos ─────────────────────────────────────────────────────────

/// One review per user per truck enforced by unique constraint.
/// isVisible lets admins hide abusive content without deleting it.
/// rating must be 1-5 — enforced at the application layer (Prisma has no CHECK support).
model Review {
  id                String    @id @default(uuid())
  truckId           String?   @map("truck_id") // null means the truck was deleted — the review is orphaned, kept for record-keeping, invisible everywhere in the product (no "my reviews" page yet)
  userId            String?   @map("user_id") // null means the author was erased — the review is anonymized (kept, "Deleted user"), never invisible like an orphaned-truck review
  rating            Int // 1-5; validated in API before write
  body              String?
  isVisible         Boolean   @default(true) @map("is_visible")
  moderationNote    String?   @map("moderation_note") // reason for the most recent hide/unhide
  moderatedByUserId String?   @map("moderated_by_user_id")
  moderatedAt       DateTime? @map("moderated_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  truck     Truck?        @relation(fields: [truckId], references: [id], onDelete: SetNull)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Was already nullable with no onDelete written — same implicit-SetNull default as
  // TruckInvite.acceptedByUser above, made explicit rather than changed.
  moderator User?         @relation("ReviewModerator", fields: [moderatedByUserId], references: [id], onDelete: SetNull)
  photos    ReviewPhoto[]
  reports   ContentReport[]

  @@unique([truckId, userId])
  @@map("reviews")
}

/// Photos uploaded by customers alongside their reviews.
/// truckId is denormalized here to avoid a join when querying the feed.
/// likesCount is a denormalized counter — incremented/decremented by PhotoLike inserts/deletes.
model ReviewPhoto {
  id         String   @id @default(uuid())
  reviewId   String   @map("review_id")
  userId     String?  @map("user_id") // null means the author was erased — see Review.userId
  truckId    String?  @map("truck_id") // null means the truck was deleted — see Review.truckId
  url        String
  caption    String?
  isVisible  Boolean  @default(true) @map("is_visible")
  likesCount Int      @default(0) @map("likes_count")
  createdAt  DateTime @default(now()) @map("created_at")
  /// Moderation audit trail — parity with Review's own moderationNote/
  /// moderatedByUserId/moderatedAt, added alongside content reporting since
  /// photos previously had no admin moderation capability at all.
  moderationNote    String?   @map("moderation_note")
  moderatedByUserId String?   @map("moderated_by_user_id")
  moderatedAt       DateTime? @map("moderated_at")

  review    Review          @relation(fields: [reviewId], references: [id])
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  truck     Truck?          @relation(fields: [truckId], references: [id], onDelete: SetNull)
  moderator User?           @relation("ReviewPhotoModerator", fields: [moderatedByUserId], references: [id], onDelete: SetNull)
  likes     PhotoLike[]
  reports   ContentReport[]

  @@map("review_photos")
}

/// Join table for photo likes. Composite PK prevents duplicate likes.
model PhotoLike {
  photoId   String   @map("photo_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  // photoId stays RESTRICT deliberately — see lib/review-photos.ts, likes must be
  // removed before a ReviewPhoto can be deleted, no cascade shortcut there.
  photo ReviewPhoto @relation(fields: [photoId], references: [id])
  // Cascade: a like is purely personal, no third-party interest in keeping it once
  // the liker is erased — same bucket as TruckOperator above and the favorites
  // tables below. Note: raw cascade removes the row but does NOT decrement the
  // liked photo's denormalized likesCount — lib/user-erasure.ts's erasure job must
  // call lib/review-photos.ts#removeAllPhotoLikesForUser explicitly first so the
  // counter stays correct; see that function's doc comment.
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([photoId, userId])
  @@map("photo_likes")
}

// ─── Favorites ──────────────────────────────────────────────────────────────
//
// Unlike PhotoLike above, both FKs here cascade — a favorite has no
// preserve-for-record-keeping value once its truck/menu item is gone (unlike
// a review), same reasoning that justified onDelete: Cascade on
// TruckOperator/TruckLocation/etc. Private only — no denormalized count,
// see docs/features/account.md#favorites.

/// A user's saved truck. Composite PK prevents duplicate favorites.
model TruckFavorite {
  truckId   String   @map("truck_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  /// Opt-in, off by default (see the same reasoning as User.notifyFavoriteActive).
  /// Toggled on the truck's own detail page, not /account — only meaningful once
  /// this favorite row exists, unlike notifyFavoriteActive which is a User-level
  /// preference covering every favorited truck at once.
  notifyNewEvents Boolean @default(false) @map("notify_new_events")

  truck Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([truckId, userId])
  @@map("truck_favorites")
}

/// A user's saved menu item. Independent of TruckFavorite — a user can save a
/// specific dish without favoriting the truck as a whole.
model MenuItemFavorite {
  menuItemId String   @map("menu_item_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([menuItemId, userId])
  @@map("menu_item_favorites")
}

// ─── Events ───────────────────────────────────────────────────────────────────

/// Special truck appearances and events. Planned feature — not yet wired to the UI.
model TruckEvent {
  id          String                                 @id @default(uuid())
  truckId     String                                 @map("truck_id")
  title       String
  description String?
  startsAt    DateTime?                              @map("starts_at")
  endsAt      DateTime?                              @map("ends_at")
  address     String?
  geom        Unsupported("geography(Point, 4326)")?
  createdAt   DateTime                               @default(now()) @map("created_at")

  truck Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)

  @@map("truck_events")
}

// ─── Account erasure & moderation ────────────────────────────────────────────

/// Generic admin queue for conditions this app can't safely automate. Currently
/// fed by exactly one trigger — a user's account erasure blocked because they're
/// the sole owner of at least one truck — but the shape (subject snapshot, reason,
/// status, resolution audit trail) is deliberately generic, not hardcoded to that
/// one case, so a future trigger (e.g. user-reported content) can reuse this table.
/// subjectUserId/resolvedByUserId are nullable + SetNull, same pattern as
/// Review.userId/moderatedByUserId — an entry must outlive the users it references,
/// since the whole point of the erasure-blocked reason is that the subject
/// eventually gets erased once the entry is resolved. subjectEmail/
/// subjectDisplayName are a point-in-time snapshot captured at creation, never
/// re-derived from the live User row, which may be gone by the time an admin reads
/// a resolved entry. blockingTruckIds is a plain scalar array (Prisma has no
/// relation-array-to-scalar-array construct, and this app already uses native
/// Postgres arrays for comparable shapes — see Truck.cuisineType/MenuItem.dietaryFlags)
/// — it is a snapshot only, never trusted as still-accurate: resolution always
/// re-derives the live blocking set instead of reading this column.
model ModerationQueueEntry {
  id                 String                @id @default(uuid())
  reason             ModerationQueueReason
  status             ModerationQueueStatus @default(open)
  subjectUserId      String?               @map("subject_user_id")
  subjectEmail       String                @map("subject_email")
  subjectDisplayName String?               @map("subject_display_name")
  blockingTruckIds   String[]              @map("blocking_truck_ids")
  note               String?
  createdAt          DateTime              @default(now()) @map("created_at")
  resolvedAt         DateTime?             @map("resolved_at")
  resolvedByUserId   String?               @map("resolved_by_user_id")
  resolutionNote     String?               @map("resolution_note")

  subjectUser    User?           @relation("ModerationQueueSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  resolvedByUser User?           @relation("ModerationQueueResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  erasureRecords ErasureRecord[]

  @@index([status, reason])
  @@map("moderation_queue_entries")
}

/// The only thing that survives a completed account erasure — proof a specific
/// request was honored, without retaining the PII that made it identifiable.
/// emailHash is sha256(lowercased email), never the plaintext, so a future dispute
/// ("did you actually delete my account?") can be checked by re-hashing a
/// claimed email and comparing, without this table itself being a second place
/// personal data lives on. trigger is classified deterministically at erasure
/// time (was there a resolved ModerationQueueEntry for this subject or not) —
/// never inferred from which caller's event happened to win a race, since
/// self-service deletion, an admin's non-blocked deletion, and the webhook's own
/// send can all fire near-simultaneously.
model ErasureRecord {
  id                     String         @id @default(uuid())
  emailHash              String         @map("email_hash")
  trigger                ErasureTrigger
  moderationQueueEntryId String?        @map("moderation_queue_entry_id")
  erasedAt               DateTime       @default(now()) @map("erased_at")

  moderationQueueEntry ModerationQueueEntry? @relation(fields: [moderationQueueEntryId], references: [id])

  @@map("erasure_records")
}

// ─── Content reporting ──────────────────────────────────────────────────────

enum ContentReportReason {
  spam
  inappropriate
  harassment
  other
}

/// open: needs an admin to triage. resolved: the reported content was hidden
/// (via this report or another open report on the same item, auto-closed
/// together). dismissed: an admin decided this specific report wasn't
/// actionable — the content is untouched, and other open reports on the same
/// item are NOT auto-dismissed, since a dismissal is a judgment on this one
/// report, not proof the content itself is fine.
enum ContentReportStatus {
  open
  resolved
  dismissed
}

/// Customer-initiated report against a review or a review photo — exactly
/// one of reviewId/reviewPhotoId is set (an app-level invariant, not a DB
/// CHECK, same looseness as TruckSchedule's dayOfWeek/specificDate).
/// Deliberately NOT built on ModerationQueueEntry despite that table's
/// "generic" framing — its resolve/dismiss functions hard-code Clerk
/// account deletion/unban logic specific to the erasure-blocked use case,
/// which would be actively dangerous to trigger from a content report.
/// Resolving a report hides the underlying content via the same
/// setReviewVisibility/setReviewPhotoVisibility primitive the existing
/// per-item admin hide button uses — this table tracks only the report's
/// own disposition, not a second copy of the hide/unhide audit trail
/// already on Review/ReviewPhoto.
model ContentReport {
  id               String              @id @default(uuid())
  reviewId         String?             @map("review_id")
  reviewPhotoId    String?             @map("review_photo_id")
  reporterUserId   String?             @map("reporter_user_id")
  reason           ContentReportReason
  note             String?
  status           ContentReportStatus @default(open)
  createdAt        DateTime            @default(now()) @map("created_at")
  resolvedAt       DateTime?           @map("resolved_at")
  resolvedByUserId String?             @map("resolved_by_user_id")
  resolutionNote   String?             @map("resolution_note")

  review         Review?      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewPhoto    ReviewPhoto? @relation(fields: [reviewPhotoId], references: [id], onDelete: Cascade)
  // Nullable + SetNull, same pattern as Review.userId — a report outlives an
  // erased reporter (the report itself is evidence, not the reporter's PII).
  reporter       User?        @relation("ContentReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  resolvedByUser User?        @relation("ContentReportResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("content_reports")
}
