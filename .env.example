# Database (Neon)
DATABASE_URL=postgresql://user:password@host/chomp?sslmode=require

# App's own public origin — used to build absolute links that must be built
# server-side from a trusted value rather than any client-supplied Host
# header (e.g. manager-invite shareable links). Falls back to
# http://localhost:3000 in local dev if unset.
NEXT_PUBLIC_APP_URL=https://chompftf.com

# Demo mode (see /docs/features/demo-mode.md) — set on the separate,
# read-only demo.<domain> deployment only. Leave both unset for the real
# production/dev deployments.
# When 'true', the app never wires up Clerk at all (no ClerkProvider, no
# clerkMiddleware, no keys required): every sign-in/sign-up entry point and
# any route needing an account instead sends the visitor to NEXT_PUBLIC_SIGNUP_URL.
NEXT_PUBLIC_DEMO_MODE=false
# Where a demo visitor is sent to create a real account. Should be the real
# production app's /sign-up URL. Falls back to the local /sign-up route
# (harmless, since that's only ever read when NEXT_PUBLIC_DEMO_MODE=true).
NEXT_PUBLIC_SIGNUP_URL=https://chompftf.com/sign-up

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Also grants destructive Backend API operations as of account erasure
# (lib/clerk-admin.ts: ban/unban/delete any user) — treat with matching care
# in secret storage/rotation policy, not just as a session-verification key.
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Signing secret for the /api/webhooks/clerk endpoint (Clerk Dashboard → Webhooks)
CLERK_WEBHOOK_SECRET=whsec_...

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# Cloudflare R2 (upload intake — objects are deleted once Cloudflare Images ingests them)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=chomp-uploads
# chomp-uploads has an R2 bucket lifecycle rule (Cloudflare dashboard,
# "expire-orphaned-uploads") auto-expiring uploads/* objects after 1 day —
# a client that uploads to R2 but never calls the finalize action leaves an
# object with no app-level code path that ever cleans it up. A fresh bucket
# for a new environment needs this rule added manually; the app's own
# CLOUDFLARE_R2_* credentials are deliberately scoped too narrowly to manage
# it themselves.

# Cloudflare Images (permanent storage + resizing/delivery for uploaded photos)
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
CLOUDFLARE_API_TOKEN=

# Upstash Redis (rate limiting on review submission, truck creation, upload slots)
# Upstash Console -> your database -> REST API section
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Resend
RESEND_API_KEY=re_...
# Resend's shared test sender — works with zero DNS setup. Swap to a
# verified Chomp domain once a real product email actually ships.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Inngest (Inngest dashboard -> app -> Keys section). Not needed for local
# dev against the Inngest Dev Server (`npx inngest-cli@latest dev`) — only
# required once deployed, so Inngest Cloud can call /api/inngest securely.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://...
SENTRY_AUTH_TOKEN=

# Stripe (future)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
