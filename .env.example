# Database (Neon)
DATABASE_URL=postgresql://user:password@host/chomp?sslmode=require

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Signing secret for the /api/webhooks/clerk endpoint (Clerk Dashboard → Webhooks)
CLERK_WEBHOOK_SECRET=whsec_...

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=chomp-uploads
CLOUDFLARE_IMAGES_ACCOUNT_HASH=

# Resend
RESEND_API_KEY=re_...

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Feed refresh (POST /api/cron/refresh-feed with Authorization: Bearer <this>)
CRON_SECRET=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://...
SENTRY_AUTH_TOKEN=

