# Database (Neon)
DATABASE_URL=postgresql://user:password@host/chomp?sslmode=require

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Signing secret for the /api/webhooks/clerk endpoint (Clerk Dashboard → Webhooks)
CLERK_WEBHOOK_SECRET=whsec_...

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# Cloudflare R2 (upload intake — objects are deleted once Cloudflare Images ingests them)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=chomp-uploads
# Set an R2 bucket lifecycle rule (Cloudflare dashboard) to auto-expire objects
# older than ~24h — a client that uploads to R2 but never calls the finalize
# action leaves an object with no app-level code path that ever cleans it up.

# Cloudflare Images (permanent storage + resizing/delivery for uploaded photos)
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
CLOUDFLARE_API_TOKEN=

# Upstash Redis (rate limiting on review submission, truck creation, upload slots)
# Upstash Console -> your database -> REST API section
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Resend
RESEND_API_KEY=re_...

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Feed refresh (POST /api/cron/refresh-feed with Authorization: Bearer <this>)
CRON_SECRET=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://...
SENTRY_AUTH_TOKEN=

# Stripe (future)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
